rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /admins/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'role']) &&
          data.email is string && data.email.size() <= 200 &&
          data.role is string && (data.role == 'admin' || data.role == 'user') &&
          (!('name' in data) || (data.name is string && data.name.size() <= 100));
      }
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role;
    }

    match /quizzes/{quizId} {
      allow read, write: if true;

      match /media/{mediaId} {
        allow read, write: if true;
      }
    }

    match /sessions/{sessionId} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }

    match /practiceResults/{resultId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
